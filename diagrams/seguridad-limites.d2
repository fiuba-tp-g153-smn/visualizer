...@_style

# Límites de confianza. Lo que cruza cada línea punteada es lo que hay que
# controlar. Ningún servicio del sistema autentica al llamante salvo las rutas
# de estaciones y la importación de métricas.

direction: right

internet: "Internet\nsin autenticar" {
  navegador: "Navegador\ncualquiera" { class: navegador }
}

edge: "Borde: proxy inverso con TLS" {
  proxy: "Caddy / Coolify" { class: servicio }
}

publico: "Zona publicada — anónima" {
  vis: "Visualizador\n6010" { class: servicio }
  data: "Servicio de datos\n6006" { class: servicio }
  alerts: "Servicio de avisos\n6007" { class: servicio }
  metrics: "API de métricas\n6020" { class: servicio }
}

interna: "Zona que debería ser interna" {
  s3: "Almacén de objetos\n9000 · 8888 · 9333 · 23646" { class: almacen }
  amqp: "Broker de mensajes\n5672 · 15672" { class: cola }
  redis: "Caché\n6379" { class: almacen }
  mysql: "Base de avisos\n3306" { class: almacen }
}

externo: "Terceros y sistemas del SMN" {
  smn: "MySQL operativa del SMN\ny API del SMN" { class: externo }
  fuentes: "NOAA · ECMWF · IGN\nEsri · Google" { class: externo }
}

navegador -> proxy: "HTTPS"
proxy -> vis
navegador -> data: "directo, sin proxy"
navegador -> alerts: "directo, sin proxy"
navegador -> metrics: "directo, sin proxy"

data -> s3
data -> redis
alerts -> mysql
alerts -> smn: "escribe el aviso"
s3 <- amqp: "procesamiento"
data -> fuentes: "respaldo de mapas base"
navegador -> fuentes: "teselas y WMS"
