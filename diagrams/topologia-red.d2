...@_style

# Los cuatro stacks de compose y cómo se alcanzan entre sí.
# No hay una red compartida: el tráfico entre stacks sale al host y vuelve a
# entrar por un puerto publicado. Es la costura que hay que tener presente al
# filtrar tráfico.

direction: right

host: "Host — puertos publicados" {
  style.stroke-dash: 3

  tp: "Stack: procesador de mosaicos" {
    rabbit: "broker" { class: cola }
    swfs: "almacén de objetos" { class: almacen }
    prod: "productor" { class: servicio }
    work: "trabajadores x5" { class: servicio }
    mapi: "API de métricas" { class: servicio }
  }

  ds: "Stack: servicio de datos\nred data_service_network (externa)" {
    redis: "caché" { class: almacen }
    api: "API web" { class: servicio }
    sync: "sincronizador" { class: servicio }
  }

  al: "Stack: servicio de avisos" {
    mysql: "MySQL local" { class: almacen }
    aapi: "API de avisos" { class: servicio }
  }

  vi: "Stack: visualizador" {
    nginx: "servidor web" { class: servicio }
  }
}

prod -> rabbit: "publica trabajo"
rabbit -> work: "toma trabajo"
work -> swfs: "escribe teselas"
mapi -> rabbit

api -> redis
sync -> redis
api -> swfs: "host.docker.internal:9000\nsale al host y vuelve" { style.stroke-dash: 3 }
sync -> swfs: "ídem" { style.stroke-dash: 3 }
aapi -> mysql
